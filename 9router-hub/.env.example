# 复制为 .env 后在本目录执行: npm start

PORT=30200
HUB_DATA_DIR=./data

# HUB_JWT_SECRET：用户登录 Hub、边缘节点 heartbeat/schedule 时带的 Hub Access Token
HUB_JWT_SECRET=change-me-hub-access

# FEDERATION_JWT_SECRET：Hub 发给「借入→出借」请求的联邦 JWT；须与 9router / 9router-dev2 的 .env 完全一致
FEDERATION_JWT_SECRET=9router-fed-dev

WELCOME_USD=10
HOLD_USD=0.05
LEDGER_MATCH_TOLERANCE_USD=0.001
LEDGER_PENDING_EXPIRE_DAYS=7
OFFICIAL_DEVICE_IDS=d_official_0001
UI_REFRESH_MS=8000

# HUB_ADMIN_TOKEN=your-admin-secret
