# 复制为 .env 后在本目录执行: npm run dev
# 命令行里已 export 的变量优先；未设置的项用代码内默认值

INSTANCE_NAME=9router
PORT=20128

# 监听地址：0.0.0.0 表示局域网可访问；默认 127.0.0.1 仅本机
# HOSTNAME=0.0.0.0

# 对外公网 / 联邦出借：在 Dashboard 开启 Tailscale（或 tunnel），无需在此配置 URL

# DATA_DIR 默认 ~/.9router（Windows: %APPDATA%/9router）
# DATA_DIR=/var/lib/9router

# 同机多个 9router 实例时，每个实例设不同盐，避免 Hub 联邦 deviceId 冲突
# MACHINE_ID_SALT=instance-b

# JWT_SECRET 控制台会话；不设则自动生成到 DATA_DIR/jwt-secret
# JWT_SECRET=change-me

# 须与 9router-hub/.env 的 FEDERATION_JWT_SECRET 一致
FEDERATION_JWT_SECRET=9router-fed-dev
